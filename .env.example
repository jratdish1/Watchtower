WATCHTOWER_API_KEY=generate_a_secure_random_key_here
WATCHTOWER_API_PORT=4040
# A22: sensors and beacon post here. Hub: keep loopback. Edge: setup writes the hub URL
# (use the hub Tailscale IP). Port must match WATCHTOWER_API_PORT on the hub.
WATCHTOWER_API_URL=http://127.0.0.1:4040
WATCHTOWER_UI_PORT=8080
# A17: default loopback. For a fleet hub set this to the hub's Tailscale IP.
# Never 0.0.0.0 on a host with a public interface.
WATCHTOWER_BIND_ADDRESS=127.0.0.1
# A27: Glass Pane UI interface. Same rule as the API: one IP, never every interface. Default loopback.
WATCHTOWER_UI_BIND_ADDRESS=127.0.0.1
# A27: where the UI proxy reaches the API. Default = WATCHTOWER_BIND_ADDRESS (same host). Hostname allowed.
# WATCHTOWER_API_HOST=
# A27: busy-port retries at boot (3 s apart) before exit 1. Default 20.
# WATCHTOWER_LISTEN_RETRY_MAX=20
# A16: honeypot decoy interface (one IPv4 literal). Default loopback.
WATCHTOWER_HONEYPOT_BIND=127.0.0.1

# Cognitive Engine
# Local LM Studio, Ollama, or Cloud API (OpenAI/Anthropic)
AI_INFERENCE_URL=http://127.0.0.1:1234/v1/chat/completions
AI_MODEL_ID=local-model

# Directories
# Relative paths resolve from the repository root, including when start.sh
# launches the API from backend/.
WATCHTOWER_DATA_DIR=./data
WATCHTOWER_TARGET_DIR=/path/to/monitor
PYTHON_BIN=python3

# Public origin beacons use to download OTA. Unset refuses upload (no loopback URL).
# WATCHTOWER_PUBLIC_BASE_URL=https://hub.example:3000
# Trust X-Forwarded-For for login throttling only when the socket is this address.
# WATCHTOWER_TRUSTED_PROXY=127.0.0.1

# ==========================================
# SENSOR MANAGEMENT (Feature Toggles)
# ==========================================
ENABLE_FIM=true
ENABLE_ORACLE=true
ENABLE_NDR=false     # Note: Requires Zeek to be installed (see README)
ENABLE_ARCHIVER=true
ENABLE_OVERSEER=true

AUTO_REMEDIATE=false  # Set to true to allow AI to quarantine without human approval
ENABLE_DECOY=true

# ==========================================
# ALLOWLIST ADAPTER (CALL A) — Host Group → profile_id
# Paper: WATCHTOWER_BE_ALLOWLIST-20261001.md (da9a8407…)
# ==========================================
# Enforcement stays on. WATCHTOWER_ALLOWLIST=0 is ignored.
WATCHTOWER_ALLOWLIST=1
# Operator VETS profile_id for shared-key era. When UNSET, operator has NO
# mapped profiles → all mapped-group mutates DENY until Escalation binds + sets this.
# WATCHTOWER_OPERATOR_PROFILE_ID=
# Exact-GO override for OTA group=ALL (default forbidden)
WATCHTOWER_OTA_ALLOW_ALL=0
# Optional path to allowlist seed JSON (defaults to backend/allowlist.json)
# WATCHTOWER_ALLOWLIST_PATH=
